  m_Script: {fileID: 11500000, guid: c1bd24b0477f916408d59ea5f1223b2d, type: 3}
  m_Name: LemonNPC_Start
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  NPCName: Lemon
  Sentences:
  - This forest was peaceful once
  - Then the dragon came
  - It took over the forest and drove everything from its home
  - Now, nothing here lives without fear
  - The dragon must be defeated if this forest is to be peaceful again
  - Its lair is at the top of the hill, beyond the forest
  - <b>Follow the path</b>, climb the hill, and defeat the dragon
